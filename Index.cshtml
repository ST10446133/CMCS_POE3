@model IEnumerable<POE_CMCS_Mvc.Models.ClaimModel>
@{
    Layout = "_Layout";
}
<h3>Academic Manager - Claim Review & Final Approval</h3>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Claim ID</th>
            <th>Lecturer</th>
            <th>Hours</th>
            <th>Rate</th>
            <th>Total</th> 
            <th>Notes</th>
            <th>File</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.ClaimId</td>
                <td>@c.LecturerUsername</td>
                <td>@c.HoursWorked</td>
                <td>@c.HourlyRate</td>

                <!-- NEW TOTAL COLUMN -->
                <td>@c.TotalAmount.ToString("F2")</td>

                <td>@(string.IsNullOrWhiteSpace(c.Notes) ? "-" : c.Notes)</td>

                <td>
                    @if (!string.IsNullOrWhiteSpace(c.FileName))
                    {
                        <a class="btn btn-sm btn-outline-primary" href="/AcademicManager/Download/@c.ClaimId">Open</a>
                    }
                    else
                    {
                        <span class="text-muted">No file</span>
                    }
                </td>

                <td>@c.Status</td>

                <td>@(c.DateSubmitted == DateTime.MinValue ? "" : c.DateSubmitted.ToString("g"))</td>

                <td>
                    <form method="post" asp-action="FinalApprove" class="d-inline">
                        <input type="hidden" name="id" value="@c.ClaimId" />
                        <button class="btn btn-sm btn-success">Final Approve</button>
                    </form>

                    <form method="post" asp-action="Reject" class="d-inline ma-1">
                        <input type="hidden" name="id" value="@c.ClaimId" />
                        <button class="btn btn-sm btn-danger">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
